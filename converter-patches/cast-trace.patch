 // Keep large variant-local temporaries off unrelated recursive expression frames.
 #[inline(never)]
+// Opt-in bounded diagnostics for a cast disappearing across receiver/slot paths.
+fn profile_cast_boundary(stage: &str, expr: &Expr, env: &ShapeEnv, slot: Option<&Slot>, ctx: LowerCtx) {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    static COUNT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    if !*ENABLED.get_or_init(|| std::env::var_os("NEW_JAVA2RUST_PROFILE_CASTS").is_some()) { return; }
+    let cast = match expr {
+        Expr::Cast { .. } => expr,
+        Expr::Call { receiver: Some(receiver), .. } if matches!(receiver.as_ref(), Expr::Cast { .. }) => receiver.as_ref(),
+        _ => return,
+    };
+    if COUNT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) >= 64 { return; }
+    if let Expr::Cast { ty, expr: source } = cast {
+        let actual = infer_expr_shape_with_context(source, env, ctx.expr_shape_context());
+        let plan = plan_cast_conversion_from_actual(actual.clone(), ty, ctx.expr_shape_context());
+        eprintln!("new_java2rust_cast_profile\t{stage}\towner={:?}\tsource={:?}\ttarget={:?}\tslot={:?}\tplan={:?}", ctx.current_type, actual, ty, slot, plan);
+    }
+}
